# IDEs
.vs/
.vscode/
*.user
*.suo
*.DotSettings.user

# JetBrains Rider: versiona so o que e compartilhavel entre maquinas (run configurations
# marcadas como "Store as project file", nome do projeto, vcs.xml). Estado por maquina/sessao
# (workspace.xml, caches, datasources locais, etc.) fica de fora.
.idea/*
!.idea/*/
.idea/*/*
!.idea/*/.idea/
.idea/*/.idea/*
!.idea/*/.idea/runConfigurations/
!.idea/*/.idea/runConfigurations/*
!.idea/*/.idea/.name
!.idea/*/.idea/vcs.xml

# Segredos / configuracoes locais
.env
.env.*
**/appsettings.Local.json
*.pfx
# Certificados de CA de rede/proxy (especificos de cada maquina; ver README > Docker)
*.crt
*.pem

# Rascunho local do agente (memoria de execucao e relatorios de cobertura)
.claude/epics/
.claude/reports/
